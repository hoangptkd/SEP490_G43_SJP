# Backend environment variables
# Copy to .env for local use. Do not commit real secrets.

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_recruitment
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT
JWT_SECRET=<change-this-to-a-long-random-secret-minimum-32-chars>
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# URLs
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8080/api

# Local demo data
APP_DATA_SEEDER_ENABLED=true

# Email verification
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<gmail-address>
MAIL_PASSWORD=<gmail-app-password>
MAIL_FROM=<gmail-address>
MAIL_HEALTH_ENABLED=false
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ROLE_SELECTION_TOKEN_TTL_MINUTES=15

# Storage
# Keep private uploads outside the repository and static web roots.
CV_UPLOAD_DIR=
AVATAR_UPLOAD_DIR=

# Public auth throttling
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_REQUESTS=10
AUTH_RATE_LIMIT_REGISTER_REQUESTS=5
AUTH_RATE_LIMIT_FORGOT_PASSWORD_REQUESTS=5
AUTH_RATE_LIMIT_RESET_PASSWORD_REQUESTS=10
AUTH_RATE_LIMIT_RESEND_VERIFICATION_REQUESTS=3

# PayOS Payment (https://my.payos.vn — lấy Client ID / API Key / Checksum Key)
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ENDPOINT=https://api-merchant.payos.vn
# Webhook URL trên PayOS portal: {BACKEND_BASE_URL}/payments/payos/webhook
# Ví dụ local cần tunnel: https://xxxx.ngrok-free.app/api/payments/payos/webhook

# MoMo Payment
# Sandbox defaults work for testing. For production: https://business.momo.vn
MOMO_ENABLED=false
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_SANDBOX=true

# VNPay Payment
# Register at https://sandbox.vnpayment.vn / https://vnpay.vn
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SANDBOX=true

# Bank transfer + VietQR
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_BANK_CODE=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_BRANCH=
BANK_TRANSFER_EXPIRE_MINUTES=15

# IPN URLs must be public HTTPS in production (use ngrok for local):
# PayOS: {BACKEND_BASE_URL}/payments/payos/webhook
# MoMo:  {BACKEND_BASE_URL}/payments/momo/ipn
# VNPay: {BACKEND_BASE_URL}/payments/vnpay/ipn


# AI Interview providers
GLADIA_API_KEY=
GLADIA_BASE_URL=https://api.gladia.io
SHOPAIKEY_API_KEY=
SHOPAIKEY_BASE_URL=https://api.shopaikey.com/v1
SHOPAIKEY_MODEL=gpt-5-mini-2025-08-07
AI_INTERVIEW_TEXT_PROVIDER=shopaikey
# Optional. Defaults to SHOPAIKEY_BASE_URL and SHOPAIKEY_API_KEY.
AI_INTERVIEW_TEXT_BASE_URL=https://api.shopaikey.com/v1
AI_INTERVIEW_TEXT_API_KEY=
AI_INTERVIEW_CV_MODEL=gemini-2.5-pro
AI_INTERVIEW_CV_EFFORT=none
AI_INTERVIEW_CV_REASONING_ENABLED=false
AI_INTERVIEW_CV_MAX_ATTEMPTS=3
AI_INTERVIEW_INITIAL_MODEL=gemini-3.5-flash
AI_INTERVIEW_INITIAL_EFFORT=none
AI_INTERVIEW_INITIAL_REASONING_ENABLED=false
AI_INTERVIEW_INITIAL_MAX_ATTEMPTS=3
AI_INTERVIEW_TURN_DECISION_MODEL=gemini-3.5-flash-lite
AI_INTERVIEW_TURN_DECISION_EFFORT=none
AI_INTERVIEW_TURN_DECISION_REASONING_ENABLED=false
AI_INTERVIEW_TURN_DECISION_MAX_ATTEMPTS=1
AI_INTERVIEW_TURN_DECISION_TIMEOUT_MS=15000
AI_INTERVIEW_TURN_EVIDENCE_MODEL=gemini-3.1-flash-lite
AI_INTERVIEW_TURN_EVIDENCE_EFFORT=none
AI_INTERVIEW_TURN_EVIDENCE_REASONING_ENABLED=false
AI_INTERVIEW_TURN_EVIDENCE_MAX_ATTEMPTS=3
AI_INTERVIEW_TURN_EVIDENCE_TIMEOUT_MS=60000
AI_INTERVIEW_ADAPTIVE_MODEL=gemini-3.5-flash
AI_INTERVIEW_ADAPTIVE_EFFORT=none
AI_INTERVIEW_ADAPTIVE_REASONING_ENABLED=false
AI_INTERVIEW_ADAPTIVE_MAX_ATTEMPTS=3
AI_INTERVIEW_TRANSCRIPT_MODEL=gemini-2.5-flash-lite
AI_INTERVIEW_TRANSCRIPT_EFFORT=none
AI_INTERVIEW_TRANSCRIPT_REASONING_ENABLED=false
AI_INTERVIEW_TRANSCRIPT_MAX_ATTEMPTS=3
AI_INTERVIEW_FINAL_MODEL=gemini-2.5-pro
AI_INTERVIEW_FINAL_EFFORT=none
AI_INTERVIEW_FINAL_REASONING_ENABLED=false
AI_INTERVIEW_FINAL_MAX_ATTEMPTS=3
AI_INTERVIEW_TTS_BASE_URL=https://api.shopaikey.com
AI_INTERVIEW_TTS_MODEL=gemini-3.1-flash-tts-preview
AI_INTERVIEW_TTS_VOICE=Kore
AI_INTERVIEW_TTS_VOICE_INSTRUCTION=Speak naturally as a professional Vietnamese interviewer. Use a warm, conversational tone and moderate pace. Pronounce English technical terms naturally in English. Do not add or remove words.
AI_INTERVIEW_TTS_CONNECT_TIMEOUT_MS=2000
AI_INTERVIEW_TTS_FIRST_AUDIO_TIMEOUT_MS=12000
AI_INTERVIEW_TTS_IDLE_TIMEOUT_MS=3000
AI_INTERVIEW_TTS_CACHE_MAX_ENTRIES=100
AI_INTERVIEW_TTS_CACHE_TTL_SECONDS=1800
AI_INTERVIEW_TTS_PREFETCH_INITIAL_WAIT_MS=20000
AI_INTERVIEW_TTS_PREFETCH_PLAYBACK_WAIT_MS=1200
AI_INTERVIEW_TTS_PREFETCH_COOLDOWN_MS=30000
AI_INTERVIEW_AUDIO_MAX_SECONDS=180
AI_INTERVIEW_AUDIO_MAX_SIZE_MB=25
AI_INTERVIEW_QUESTION_COUNT=5
AI_INTERVIEW_MAX_FOLLOW_UPS_PER_CORE=1
AI_INTERVIEW_MAX_PROBES_PER_CORE=1
AI_INTERVIEW_MAX_CLARIFIES_PER_CORE=1
AI_INTERVIEW_MAX_TOTAL_ASSESSMENT_TURNS=10
AI_INTERVIEW_PROVIDER_CONNECT_TIMEOUT_MS=5000
AI_INTERVIEW_PROVIDER_READ_TIMEOUT_MS=60000
AI_INTERVIEW_VOICE_STREAMING_ENABLED=true
AI_INTERVIEW_VOICE_PROVIDER=shopaikey_gemini_stream
AI_INTERVIEW_VOICE_EVIDENCE_CORE_POOL_SIZE=2
AI_INTERVIEW_VOICE_EVIDENCE_QUEUE_CAPACITY=4
AI_INTERVIEW_VOICE_EVIDENCE_AWAIT_TIMEOUT_MS=5000
AI_INTERVIEW_ANSWER_TRANSCRIPTION_PROVIDER=speechmatics_realtime
SPEECHMATICS_REALTIME_ENABLED=true
SPEECHMATICS_API_KEY=
SPEECHMATICS_REALTIME_URL=wss://global.rt.speechmatics.com/v2/
SPEECHMATICS_LANGUAGE=vi
SPEECHMATICS_OPERATING_POINT=standard
SPEECHMATICS_MAX_DELAY_SECONDS=1.5
SPEECHMATICS_TICKET_TTL_SECONDS=60
SPEECHMATICS_CONNECT_TIMEOUT_MS=8000
SPEECHMATICS_FINAL_FLUSH_TIMEOUT_MS=15000
SPEECHMATICS_MAX_CONCURRENT_SESSIONS=20
AI_INTERVIEW_TRANSCRIPT_CORRECTION_ENABLED=false
AI_INTERVIEW_TRANSCRIPT_CORRECTION_MIN_CONFIDENCE=0.90
AI_INTERVIEW_TRANSCRIPT_CORRECTION_MAX_CORRECTIONS=12
AI_INTERVIEW_TRANSCRIPT_CORRECTION_MAX_EVIDENCE_ITEMS=12
AI_INTERVIEW_TRANSCRIPT_CORRECTION_MAX_CONTEXT_TERMS=100
AI_INTERVIEW_TRANSCRIPT_CORRECTION_MAX_PREVIOUS_CONTEXT_CHARS=1200
AI_INTERVIEW_TRANSCRIPT_CORRECTION_TIMEOUT_MS=15000
AI_INTERVIEW_TRANSCRIPT_CORRECTION_PROMPT_VERSION=browser-transcript-correction-v2
AI_INTERVIEW_VOICE_CONFIRMATION_PROMPT_DELAY_MS=2000
AI_INTERVIEW_VOICE_CONFIRMATION_AUTO_FINALIZE_MS=3000
AI_INTERVIEW_VOICE_RECOGNITION_RESTART_DELAY_MS=250
AI_INTERVIEW_VOICE_LOAD_WAIT_MS=700
AI_INTERVIEW_VOICE_NEXT_QUESTION_DELAY_MS=0
AI_INTERVIEW_BACKGROUND_CORE_POOL_SIZE=4
AI_INTERVIEW_BACKGROUND_QUEUE_CAPACITY=32
AI_INTERVIEW_COSTLY_REQUESTS_PER_MINUTE=12

# Voice activity detection. VAD_FFMPEG_PATH must be an absolute ffmpeg executable path when required=true.
VAD_ENABLED=true
VAD_REQUIRED=false
VAD_FFMPEG_PATH=
MAX_UPLOAD_SIZE=25MB
